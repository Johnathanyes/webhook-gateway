# Copy this file to .env before `docker compose up`. Both values are required;
# compose refuses to start if either is empty.
#
#   cp .env.example .env
#   printf 'ENCRYPTION_KEY=%s\n' "$(openssl rand -base64 32)" >> .env
#   # then set ADMIN_PASSWORD below

# Bearer token for every /api/* endpoint. Treat it like a root password.
ADMIN_PASSWORD=

# Encrypts signing secrets at rest (AES-256-GCM). Must be base64 that decodes
# to exactly 32 bytes: `openssl rand -base64 32`.
# Losing or changing this makes every stored signing secret unreadable.
ENCRYPTION_KEY=

# Optional. Host port the gateway is published on (container side is 8080).
# PORT=8080

# Optional. Postgres password inside the stack; only reachable on the compose
# network, so the default is fine unless you publish the database yourself.
# POSTGRES_PASSWORD=gateway
